{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RustrenScene",
  "type": "object",
  "additionalProperties": false,
  "required": ["canvas", "layers"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "default": "1.0",
      "description": "Scene schema version (supported: 1.0 - 1.1)"
    },
    "min_renderer_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Minimum renderer version required to render this scene"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "duration_secs"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "description": "Canvas width in px" },
        "height": { "type": "integer", "minimum": 1, "description": "Canvas height in px" },
        "fps": { "type": "integer", "minimum": 1, "description": "Frame per second" },
        "duration_secs": { "type": "number", "exclusiveMinimum": 0, "description": "Total video duration in seconds" },
        "background": { "$ref": "#/$defs/HexColor", "default": "#000000" }
      }
    },
    "fonts": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Font file paths (.ttf/.otf). Empty = fallback to system sans-serif."
    },
    "audio": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src"],
        "properties": {
          "src": { "type": "string", "description": "Local path or audio URL" },
          "start_sec": { "type": "number", "minimum": 0, "default": 0.0 },
          "volume": { "type": "number", "minimum": 0, "default": 1.0 },
          "trim_start_sec": { "type": "number", "minimum": 0 },
          "trim_end_sec": { "type": "number", "minimum": 0 },
          "playback_rate": { "type": "number", "exclusiveMinimum": 0, "default": 1.0, "description": "Audio playback speed (1.0 = normal)" }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/Layer" },
      "description": "Back-to-front z-order; root layers use absolute canvas coordinates."
    }
  },
  "$defs": {
    "HexColor": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "LinearGradient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["linear", "radial"], "default": "linear" },
        "from": { "$ref": "#/$defs/HexColor" },
        "to": { "$ref": "#/$defs/HexColor" },
        "stops": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offset", "color"],
            "properties": {
              "offset": { "type": "number", "minimum": 0, "maximum": 1 },
              "color": { "$ref": "#/$defs/HexColor" }
            }
          }
        },
        "angle": { "type": "number", "default": 0.0, "description": "Clockwise degrees (0 = left to right)" }
      }
    },
    "Layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": { "enum": ["row", "column"], "default": "row" },
        "justify_content": { "enum": ["start", "center", "end", "space_between", "space_around", "stretch", "flex_start", "flex_end"] },
        "align_items": { "enum": ["start", "center", "end", "space_between", "space_around", "stretch", "flex_start", "flex_end"] },
        "gap": { "type": "number", "default": 0.0 },
        "padding": { "type": "number", "default": 0.0 }
      }
    },
    "BlendMode": {
      "enum": [
        "normal", "multiply", "screen", "overlay", "darken", "lighten",
        "color_dodge", "color_burn", "hard_light", "soft_light", "difference", "exclusion"
      ],
      "default": "normal"
    },
    "Shadow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/HexColor", "default": "#00000080" },
        "offset_x": { "type": "number", "default": 0.0 },
        "offset_y": { "type": "number", "default": 0.0 },
        "blur": { "type": "number", "minimum": 0, "default": 0.0 }
      }
    },
    "TextSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "color": { "$ref": "#/$defs/HexColor" },
        "font_weight": { "enum": ["normal", "bold"] },
        "font_family": { "type": "string" },
        "font_size": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "SpringConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stiffness": { "type": "number", "exclusiveMinimum": 0, "default": 120.0 },
        "damping": { "type": "number", "minimum": 0, "default": 14.0 },
        "mass": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 }
      }
    },
    "Animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property"],
      "properties": {
        "property": {
          "enum": [
            "x", "y", "width", "height", "opacity", "scale", "rotation", "skew_x", "skew_y", "cx", "cy", "r", "radius",
            "color", "background", "border_color", "path_progress", "stroke_dashoffset"
          ],
          "description": "Animatable layer property."
        },
        "from": {
          "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/HexColor" }]
        },
        "to": {
          "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/HexColor" }]
        },
        "start_sec": { "type": "number", "minimum": 0, "description": "Global video time (seconds)" },
        "end_sec": { "type": "number", "minimum": 0, "description": "Global video time (seconds)" },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["time", "value"],
            "properties": {
              "time": { "type": "number", "minimum": 0 },
              "value": { "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/HexColor" }] },
              "easing": { "type": "string" },
              "bezier": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
            }
          }
        },
        "easing": {
          "enum": [
            "linear", "ease_in", "ease_out", "ease_in_out",
            "ease_in_quad", "ease_out_quad", "ease_in_out_quad",
            "ease_in_expo", "ease_out_expo", "ease_in_out_expo",
            "ease_in_back", "ease_out_back", "ease_in_out_back",
            "ease_out_bounce", "cubic_bezier", "spring"
          ],
          "default": "linear"
        },
        "bezier": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "Control points [x1, y1, x2, y2] for cubic_bezier easing"
        },
        "spring": { "$ref": "#/$defs/SpringConfig" },
        "repeat": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "infinite" }],
          "description": "Number of animation cycle repeats or infinite"
        },
        "yoyo": { "type": "boolean", "default": false, "description": "If true, odd cycles reverse direction (to -> from)" }
      }
    },
    "Layer": {
      "oneOf": [
        { "$ref": "#/$defs/ContainerLayer" },
        { "$ref": "#/$defs/RectLayer" },
        { "$ref": "#/$defs/CircleLayer" },
        { "$ref": "#/$defs/TextLayer" },
        { "$ref": "#/$defs/SvgLayer" },
        { "$ref": "#/$defs/ImageLayer" },
        { "$ref": "#/$defs/VideoLayer" }
      ]
    },
    "ContainerLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "container" },
        "position": { "enum": ["relative", "absolute"], "default": "relative" },
        "start_sec": { "type": "number", "minimum": 0, "default": 0.0 },
        "end_sec": { "type": "number", "minimum": 0 },
        "duration_secs": { "type": "number", "minimum": 0, "description": "Layer duration (alternative to end_sec = start_sec + duration_secs)" },
        "overlap_secs": { "type": "number", "minimum": 0, "default": 0.0, "description": "Backward overlap in container timeline series mode" },
        "flex_grow": { "type": "number" },
        "margin": { "type": "number" },
        "blend_mode": { "$ref": "#/$defs/BlendMode" },
        "blur": { "type": "number", "minimum": 0, "default": 0.0 },
        "shadow": { "$ref": "#/$defs/Shadow" },
        "x": { "type": "number", "default": 0.0 },
        "y": { "type": "number", "default": 0.0 },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "radius": { "type": "number", "default": 0.0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "rotation": { "type": "number", "default": 0.0, "description": "Clockwise rotation in degrees" },
        "anchor": { "enum": ["top_left", "top_center", "top_right", "center_left", "center", "center_right", "bottom_left", "bottom_center", "bottom_right"], "default": "top_left" },
        "skew_x": { "type": "number", "default": 0.0 },
        "skew_y": { "type": "number", "default": 0.0 },
        "clip": { "type": "boolean", "default": false, "description": "If true, children are clipped to container bounds and radius (overflow: hidden)" },
        "cascade_opacity": { "type": "boolean", "default": false, "description": "If true, container opacity multiplies into children" },
        "timeline": { "enum": ["global", "local", "series"], "default": "global", "description": "global = canvas time; local = relative to container start_sec; series = sequential children" },
        "stagger_secs": { "type": "number", "minimum": 0, "default": 0.0, "description": "Progressive delay between children in seconds" },
        "background": { "$ref": "#/$defs/HexColor" },
        "gradient": { "$ref": "#/$defs/LinearGradient" },
        "border_color": { "$ref": "#/$defs/HexColor" },
        "border_width": { "type": "number", "default": 0.0 },
        "layout": { "$ref": "#/$defs/Layout" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/Layer" } },
        "animations": { "type": "array", "items": { "$ref": "#/$defs/Animation" } }
      }
    },
    "RectLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "width", "height", "color"],
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "rect" },
        "position": { "enum": ["relative", "absolute"], "default": "relative" },
        "start_sec": { "type": "number", "minimum": 0, "default": 0.0 },
        "end_sec": { "type": "number", "minimum": 0 },
        "duration_secs": { "type": "number", "minimum": 0, "description": "Layer duration (alternative to end_sec = start_sec + duration_secs)" },
        "overlap_secs": { "type": "number", "minimum": 0, "default": 0.0, "description": "Backward overlap in container timeline series mode" },
        "flex_grow": { "type": "number" },
        "margin": { "type": "number" },
        "blend_mode": { "$ref": "#/$defs/BlendMode" },
        "blur": { "type": "number", "minimum": 0, "default": 0.0 },
        "shadow": { "$ref": "#/$defs/Shadow" },
        "x": { "type": "number", "default": 0.0 },
        "y": { "type": "number", "default": 0.0 },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "radius": { "type": "number", "default": 0.0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "scale": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "rotation": { "type": "number", "default": 0.0, "description": "Clockwise rotation in degrees" },
        "color": { "$ref": "#/$defs/HexColor" },
        "gradient": { "$ref": "#/$defs/LinearGradient" },
        "border_color": { "$ref": "#/$defs/HexColor" },
        "border_width": { "type": "number", "default": 0.0 },
        "path_progress": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0, "description": "Border stroke animation progress (0.0 - 1.0)" },
        "stroke_dashoffset": { "type": "number", "description": "Stroke dash offset (px)" },
        "animations": { "type": "array", "items": { "$ref": "#/$defs/Animation" } }
      }
    },
    "CircleLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "r", "color"],
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "circle" },
        "position": { "enum": ["relative", "absolute"], "default": "relative" },
        "start_sec": { "type": "number", "minimum": 0, "default": 0.0 },
        "end_sec": { "type": "number", "minimum": 0 },
        "duration_secs": { "type": "number", "minimum": 0, "description": "Layer duration (alternative to end_sec = start_sec + duration_secs)" },
        "overlap_secs": { "type": "number", "minimum": 0, "default": 0.0, "description": "Backward overlap in container timeline series mode" },
        "flex_grow": { "type": "number" },
        "margin": { "type": "number" },
        "blend_mode": { "$ref": "#/$defs/BlendMode" },
        "blur": { "type": "number", "minimum": 0, "default": 0.0 },
        "shadow": { "$ref": "#/$defs/Shadow" },
        "cx": { "type": "number", "default": 0.0 },
        "cy": { "type": "number", "default": 0.0 },
        "r": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "$ref": "#/$defs/HexColor" },
        "border_color": { "$ref": "#/$defs/HexColor" },
        "border_width": { "type": "number", "default": 0.0 },
        "path_progress": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0, "description": "Border stroke animation progress (0.0 - 1.0)" },
        "stroke_dashoffset": { "type": "number", "description": "Stroke dash offset (px)" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "scale": { "type": "number", "default": 1.0, "description": "Circle radius scale factor (pivoted at cx, cy)" },
        "animations": { "type": "array", "items": { "$ref": "#/$defs/Animation" } }
      }
    },
    "TextLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "text" },
        "position": { "enum": ["relative", "absolute"], "default": "relative", "description": "absolute = explicit position relative to canvas or parent container" },
        "start_sec": { "type": "number", "minimum": 0, "default": 0.0 },
        "end_sec": { "type": "number", "minimum": 0, "description": "Inclusive end time (seconds); omitted = end of video" },
        "duration_secs": { "type": "number", "minimum": 0, "description": "Layer duration (alternative to end_sec = start_sec + duration_secs)" },
        "overlap_secs": { "type": "number", "minimum": 0, "default": 0.0, "description": "Backward overlap in container timeline series mode" },
        "flex_grow": { "type": "number" },
        "margin": { "type": "number" },
        "blend_mode": { "$ref": "#/$defs/BlendMode" },
        "blur": { "type": "number", "minimum": 0, "default": 0.0 },
        "shadow": { "$ref": "#/$defs/Shadow" },
        "x": { "type": "number", "default": 0.0, "description": "Horizontal top-left position in px" },
        "y": { "type": "number", "default": 0.0, "description": "Vertical top position of text box in px" },
        "content": { "type": "string" },
        "dynamic": {
          "type": "object",
          "description": "Declarative dynamic text: typewriter, counter, or timecode mode"
        },
        "anchor": { "enum": ["top_left", "top_center", "top_right", "center_left", "center", "center_right", "bottom_left", "bottom_center", "bottom_right"], "default": "top_left" },
        "skew_x": { "type": "number", "default": 0.0 },
        "skew_y": { "type": "number", "default": 0.0 },
        "spans": { "type": "array", "items": { "$ref": "#/$defs/TextSpan" }, "description": "Rich text spans (overrides content when provided)" },
        "font_size": { "type": "number", "exclusiveMinimum": 0, "default": 48.0 },
        "line_height": { "type": "number", "exclusiveMinimum": 0 },
        "letter_spacing": { "type": "number", "default": 0.0, "description": "Extra spacing between characters in px" },
        "font_family": { "type": "string" },
        "font_weight": { "enum": ["normal", "bold"], "default": "normal" },
        "text_align": { "enum": ["left", "center", "right"], "default": "left" },
        "color": { "$ref": "#/$defs/HexColor", "default": "#FFFFFF" },
        "gradient": { "$ref": "#/$defs/LinearGradient" },
        "outline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/$defs/HexColor", "default": "#000000" },
            "width": { "type": "number", "minimum": 0, "default": 2.0 }
          }
        },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "scale": { "type": "number", "default": 1.0, "description": "Scale factor for font_size and line_height" },
        "max_width": { "type": "number", "description": "Text wrapping max width (px); recommended inside containers" },
        "animations": { "type": "array", "items": { "$ref": "#/$defs/Animation" } }
      }
    },
    "SvgLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "src"],
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "svg" },
        "position": { "enum": ["relative", "absolute"], "default": "relative" },
        "start_sec": { "type": "number", "minimum": 0, "default": 0.0 },
        "end_sec": { "type": "number", "minimum": 0 },
        "duration_secs": { "type": "number", "minimum": 0, "description": "Layer duration (alternative to end_sec = start_sec + duration_secs)" },
        "overlap_secs": { "type": "number", "minimum": 0, "default": 0.0, "description": "Backward overlap in container timeline series mode" },
        "flex_grow": { "type": "number" },
        "margin": { "type": "number" },
        "blend_mode": { "$ref": "#/$defs/BlendMode" },
        "blur": { "type": "number", "minimum": 0, "default": 0.0 },
        "shadow": { "$ref": "#/$defs/Shadow" },
        "x": { "type": "number", "default": 0.0 },
        "y": { "type": "number", "default": 0.0 },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "src": { "type": "string", "description": "Local path, URL, or inline <svg>...</svg>" },
        "path_progress": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0, "description": "SVG path/stroke draw progress (0.0 - 1.0)" },
        "stroke_dashoffset": { "type": "number", "description": "SVG stroke dash offset (px)" },
        "stroke_dasharray": { "type": "array", "items": { "type": "number", "minimum": 0 }, "description": "Custom SVG stroke dash pattern" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "rotation": { "type": "number", "default": 0.0 },
        "animations": { "type": "array", "items": { "$ref": "#/$defs/Animation" } }
      }
    },
    "ImageLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "src"],
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "image" },
        "position": { "enum": ["relative", "absolute"], "default": "relative" },
        "start_sec": { "type": "number", "minimum": 0, "default": 0.0 },
        "end_sec": { "type": "number", "minimum": 0 },
        "duration_secs": { "type": "number", "minimum": 0, "description": "Layer duration (alternative to end_sec = start_sec + duration_secs)" },
        "overlap_secs": { "type": "number", "minimum": 0, "default": 0.0, "description": "Backward overlap in container timeline series mode" },
        "flex_grow": { "type": "number" },
        "margin": { "type": "number" },
        "blend_mode": { "$ref": "#/$defs/BlendMode" },
        "blur": { "type": "number", "minimum": 0, "default": 0.0 },
        "shadow": { "$ref": "#/$defs/Shadow" },
        "x": { "type": "number", "default": 0.0 },
        "y": { "type": "number", "default": 0.0 },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "src": { "type": "string", "description": "Local path or image URL" },
        "fit": { "enum": ["fill", "cover", "contain"], "default": "fill" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "rotation": { "type": "number", "default": 0.0 },
        "scale": { "type": "number", "default": 1.0, "description": "Image scale factor from center" },
        "animations": { "type": "array", "items": { "$ref": "#/$defs/Animation" } }
      }
    },
    "VideoLayer": {
      "type": "object",
      "required": ["type", "src"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "const": "video" },
        "position": { "enum": ["relative", "absolute"], "default": "relative" },
        "start_sec": { "type": "number", "minimum": 0, "default": 0.0 },
        "end_sec": { "type": "number", "minimum": 0 },
        "flex_grow": { "type": "number" },
        "margin": { "type": "number" },
        "blend_mode": { "$ref": "#/$defs/BlendMode" },
        "blur": { "type": "number", "minimum": 0, "default": 0.0, "description": "Gaussian blur radius in px" },
        "shadow": { "$ref": "#/$defs/Shadow" },
        "duration_secs": { "type": "number", "minimum": 0, "description": "Active duration for series sequencing" },
        "overlap_secs": { "type": "number", "minimum": 0, "default": 0.0, "description": "Overlap with previous element in series (seconds)" },
        "x": { "type": "number", "description": "Explicit X position (optional inside flexbox layout)" },
        "y": { "type": "number", "description": "Explicit Y position (optional inside flexbox layout)" },
        "width": { "type": "number", "minimum": 0, "description": "Video width (default: source video width)" },
        "height": { "type": "number", "minimum": 0, "description": "Video height (default: source video height)" },
        "src": { "type": "string", "minLength": 1, "description": "Local path or video URL (MP4/MOV/WEBM)" },
        "fit": { "enum": ["fill", "cover", "contain"], "default": "fill" },
        "trim_start_sec": { "type": "number", "minimum": 0, "default": 0.0, "description": "Video trim start point (seconds)" },
        "trim_end_sec": { "type": "number", "minimum": 0, "description": "Video trim end point (seconds, optional)" },
        "playback_rate": { "type": "number", "exclusiveMinimum": 0, "default": 1.0, "description": "Video and audio playback speed (1.0 = normal)" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0, "description": "Audio volume of video clip (0.0 - 1.0)" },
        "muted": { "type": "boolean", "default": false, "description": "Mute audio from video clip" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "rotation": { "type": "number", "default": 0.0, "description": "Rotation angle in degrees" },
        "scale": { "type": "number", "default": 1.0, "description": "Video scale factor from center" },
        "animations": { "type": "array", "items": { "$ref": "#/$defs/Animation" } }
      }
    }
  }
}
